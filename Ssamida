<!DOCTYPE html><html lang="ko"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>쌤IDA 프로젝트</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style>
:root{--ink:#1B2436;--soft:#6B7688;--line:#E7ECF3;--bg:#F1F4F9}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);font-family:'Pretendard',sans-serif;color:var(--ink);padding:18px 14px 60px}
.wrap{max-width:1180px;margin:0 auto}
.hd h1{font-size:21px;font-weight:900;letter-spacing:-.5px}
.hd .sub{font-size:12px;color:var(--soft);font-weight:600;margin-top:3px}
.hd .sub b{color:#7048E8;font-weight:800}
/* D-day 오픈 카운트다운 */
.dday{margin:15px 0 4px}
.dday-box{background:linear-gradient(135deg,#7048E8,#4C6EF5);border-radius:16px;padding:16px 22px;display:flex;align-items:center;gap:16px;flex-wrap:wrap;color:#fff;box-shadow:0 4px 16px rgba(112,72,232,.22)}
.dday-box.urgent{background:linear-gradient(135deg,#E8590C,#E23A22);box-shadow:0 4px 16px rgba(226,58,34,.22)}
.dday-box.over{background:linear-gradient(135deg,#8A94A6,#6B7688)}
.dday-box .dl{display:flex;flex-direction:column;gap:3px}
.dday-box .dgoal{font-size:11px;font-weight:800;opacity:.9}
.dday-box .ddate{font-size:17px;font-weight:900;letter-spacing:-.5px}
.dday-box .dcnt{font-size:34px;font-weight:900;letter-spacing:-1.5px;margin-left:auto;line-height:1}
.dday-box .dnote{width:100%;font-size:10.5px;font-weight:600;opacity:.8;margin-top:2px}
@media(max-width:600px){.dday-box .dcnt{font-size:28px}}
/* 마감일 뱃지 */
.due{font-size:9.5px;font-weight:800;color:#E8590C;background:#FFF0E6;padding:1px 7px;border-radius:20px;margin-left:6px;white-space:nowrap}
/* 요약 스트립 */
.sumbar{display:flex;gap:9px;margin:15px 0 18px;flex-wrap:wrap}
.sumcard{flex:1;min-width:120px;background:#fff;border:1px solid var(--line);border-radius:13px;padding:12px 15px}
.sumcard .l{font-size:11px;font-weight:700;color:var(--soft)}
.sumcard .v{font-size:21px;font-weight:900;letter-spacing:-.8px;margin-top:2px}
.sumcard .v small{font-size:12px;font-weight:700;color:var(--soft)}
.sumcard.done .v{color:#20A56D}.sumcard.doing .v{color:#4C6EF5}.sumcard.plan .v{color:#B6C2DC}
/* 영역 그리드 */
.areas{display:grid;grid-template-columns:1fr 1fr;gap:13px}
@media(max-width:820px){.areas{grid-template-columns:1fr}}
.area{background:#fff;border:1px solid var(--line);border-radius:16px;overflow:hidden}
.area-hd{padding:14px 17px;display:flex;align-items:center;gap:11px;border-bottom:1px solid var(--line)}
.area-hd .ic{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
.area-hd .nm{font-size:15px;font-weight:900}
.area-hd .who{font-size:11.5px;font-weight:700;color:var(--soft);margin-top:1px}
.area-hd .cnt{margin-left:auto;font-size:11px;font-weight:700;color:var(--soft);text-align:right;white-space:nowrap}
.area-hd .cnt b{font-weight:900}
.area-hd .cnt .cd{color:#20A56D}.area-hd .cnt .cg{color:#4C6EF5}
.area.viral .ic{background:#FFF0E6;color:#E8590C}
.area.web .ic{background:#EEF0FF;color:#4C6EF5}
.area.sys .ic{background:#F0EBFF;color:#7048E8}
.area.teach .ic{background:#E6F7F0;color:#1D9E75}
/* 진행바 (완료 비율) */
.pbar{height:5px;background:#EDF1F7;position:relative}
.pbar i{position:absolute;left:0;top:0;bottom:0;border-radius:0 3px 3px 0}
.area.viral .pbar i{background:#E8590C}.area.web .pbar i{background:#4C6EF5}
.area.sys .pbar i{background:#7048E8}.area.teach .pbar i{background:#1D9E75}
/* 항목 */
.items{padding:6px 11px 14px}
.subhd{font-size:10px;font-weight:800;color:#98A4B6;margin:11px 6px 4px;letter-spacing:.4px}
.subhd:first-child{margin-top:4px}
.item{display:flex;align-items:flex-start;gap:9px;padding:6px 7px;border-radius:9px}
.item:hover{background:#FAFBFD}
.item .st{flex-shrink:0;font-size:9px;font-weight:800;padding:2px 8px;border-radius:20px;margin-top:1px;white-space:nowrap}
.st.done{background:#E6F7EE;color:#177A4A}
.st.doing{background:#EEF0FF;color:#3B4F9E}
.st.plan{background:#F0F2F7;color:#8A94A6}
.st.talk{background:#FFF4E6;color:#BA7517}
.st.review{background:#F0EBFF;color:#7048E8}
.item .tx{font-size:12.5px;font-weight:600;line-height:1.5}
.item .tx b{font-weight:800}
.item .tx .memo{display:block;font-size:11px;color:#98A4B6;font-weight:500;margin-top:1px}
.item.done .tx{color:#8A94A6}
.ft{text-align:center;font-size:11px;color:#B6C2DC;font-weight:600;margin-top:22px;line-height:1.7}
</style></head><body>
<div class="wrap">
<div class="hd">
  <h1>🚀 쌤IDA 프로젝트</h1>
  <div class="sub">신사업 구축 진행판 · <b>4개 영역</b> · 기존 아라 업무와 별개 · <span id="today"></span> 기준</div>
</div>

<div class="dday" id="dday"></div>

<div class="sumbar" id="sumbar"></div>
<div class="areas" id="areas"></div>

<div class="ft">각 담당자가 별도 신사업으로 진행 중 · 기존 아라 업무(면접·상담·매출)는 전체실적·증원현황 탭 참조</div>
</div>

<script>
// ── 쌤IDA 프로젝트 데이터 (하드코딩 · 매주 갱신) ──
// status: done(완료) / doing(진행중) / plan(예정·기획중) / talk(협의중) / review(심사중)
var OPEN_DATE = '2026-09-19';   // 오픈 목표 (사장님 지시) — 준비속도·장애물에 따라 변경 가능
var AREAS = [
  { key:'web', ic:'🎨', nm:'브랜드 · 웹', who:'김상현 이사',
    groups:[
      { hd:'완료', items:[
        {st:'done', t:'쌤IDA 사이트 1차 제작'},
        {st:'done', t:'아이스캔 사이트 1차 제작'},
        {st:'done', t:'쌤IDA 인허가 표찰·포스터 설치'},
        {st:'done', t:'네이버 브랜드검색 2학기 대비 변경'}
      ]},
      { hd:'진행중', items:[
        {st:'doing', t:'쌤IDA 사이트 보완', due:'9/10', memo:'가격·메뉴 정리, 수행평가·대입 내용 추가, 최종 (참고: 에듀플렉스/상상코칭/이지수능)'},
        {st:'doing', t:'아이스캔 사이트', due:'9/15', memo:'연혁 수정, 실제 이미지 추가'},
        {st:'doing', t:'카페 바이럴', memo:'오디플랜 모니터링, 댓글 기획 3건, 네이버 미노출 문제제기'}
      ]},
      { hd:'채널 운영', items:[
        {st:'done', t:'인스타 @쌤이다 · 페북 쌤이다 · 구글 통합계정', memo:'김상현 이사 명의'}
      ]}
    ]},
  { key:'sys', ic:'⚙️', nm:'시스템 · 백엔드', who:'이경훈 이사',
    groups:[
      { hd:'진행중', items:[
        {st:'doing', t:'가입 파이프라인', memo:'방문장등록 → 결과입력 → 회원정보 → 가입링크 → 회원가입 → 매칭 → 아이디오픈 → 선생님 배정'},
        {st:'doing', t:'openWCMS 사업부 결과입력', memo:'외부 접근 가능하게 (기존 아라 방식)'},
        {st:'doing', t:'쌤IDA CMS 어드민 구축'}
      ]},
      { hd:'예정', items:[
        {st:'plan', t:'관리자강사 권한 레벨 추가', memo:'대표강사 어드민 접근 (기존 강사=본인 수업만)'},
        {st:'plan', t:'배정조율 개인 스케줄만 노출', memo:'타 사업부 방문·미배정 숨김'},
        {st:'plan', t:'전자계약서 API 연결', memo:'유캔싸인 → 타 업체 교체(사장님 지시), 업체 선정 필요'}
      ]},
      { hd:'논의·협의', items:[
        {st:'talk', t:'KISPG 결제', memo:'3·6개월 무이자(반값 수수료) / 카드 직접입력 단점 → 에스크로 협의 예정'},
        {st:'review', t:'알림톡 채널', memo:'외부 API 연동·심사, 친구추가 없이 발송 (solapi 등)'}
      ]}
    ]},
  { key:'teach', ic:'👨‍🏫', nm:'강사 플랫폼', who:'엄현호 이사 · 신우성 주임',
    groups:[
      { hd:'완료', items:[
        {st:'done', t:'대표강사 채용', memo:'국어·영어 2명'}
      ]},
      { hd:'구축·개발중', items:[
        {st:'doing', t:'강사 = 영업 모델', memo:'대표강사로 육성'},
        {st:'doing', t:'퍼널 단축', memo:'상담→사업→결제→운영(4단계) → 상담↔사업 통합(1개)'},
        {st:'doing', t:'방문 → 시강 즉시 연결', memo:'30분 무료수업 후킹'}
      ]},
      { hd:'논의중', items:[
        {st:'talk', t:'전화 응대 방식', memo:'별도 전화 없이 강사 폰 활용? / 채널톡·카카오채널 검토'},
        {st:'talk', t:'해피콜 시간 여부'},
        {st:'talk', t:'운영시간', memo:'12시~7시 등 검토 중'}
      ]}
    ]},
  { key:'viral', ic:'📣', nm:'바이럴 · SNS', who:'신상준 이사',
    groups:[
      { hd:'완료', items:[
        {st:'done', t:'계정 개설', memo:'9/10 개설'}
      ]},
      { hd:'진행중', items:[
        {st:'doing', t:'전 SNS 채널 운영', memo:'인스타 · 블로그 · 유튜브 총괄'},
        {st:'doing', t:'카드뉴스 기획·업로드', memo:'오늘부터 시작'},
        {st:'doing', t:'광고용 소재 기획'}
      ]},
      { hd:'기획중', items:[
        {st:'plan', t:'유튜브 채널 영상 기획'},
        {st:'plan', t:'랜딩페이지 제작'}
      ]}
    ]}
];

function render(){
  var td=new Date(); td.setHours(0,0,0,0);
  document.getElementById('today').textContent=(td.getMonth()+1)+'월 '+td.getDate()+'일';
  // D-day (오픈 목표)
  var od=new Date(OPEN_DATE); od.setHours(0,0,0,0);
  var dleft=Math.round((od-td)/86400000);
  var ddayCls = dleft<0?'over':dleft<=7?'urgent':'';
  var ddayTxt = dleft>0?('D-'+dleft):dleft===0?'D-DAY':('D+'+(-dleft));
  document.getElementById('dday').innerHTML=
    '<div class="dday-box '+ddayCls+'"><div class="dl"><span class="dgoal">🎯 오픈 목표</span><span class="ddate">'+(od.getMonth()+1)+'월 '+od.getDate()+'일 오픈</span></div>'
   +'<div class="dcnt">'+ddayTxt+'</div>'
   +'<div class="dnote">사장님 지시 · 준비속도·장애물에 따라 변경 가능</div></div>';
  // 전체 집계
  var tot={done:0,doing:0,plan:0};
  AREAS.forEach(function(a){ a.groups.forEach(function(g){ g.items.forEach(function(it){
    if(it.st==='done') tot.done++;
    else if(it.st==='doing') tot.doing++;
    else tot.plan++;
  });});});
  var ppl=5;
  document.getElementById('sumbar').innerHTML=
    '<div class="sumcard done"><div class="l">완료</div><div class="v">'+tot.done+'<small>건</small></div></div>'
   +'<div class="sumcard doing"><div class="l">진행중</div><div class="v">'+tot.doing+'<small>건</small></div></div>'
   +'<div class="sumcard plan"><div class="l">예정·논의</div><div class="v">'+tot.plan+'<small>건</small></div></div>'
   +'<div class="sumcard"><div class="l">참여 인원</div><div class="v" style="color:#1B2436">'+ppl+'<small>명</small></div></div>';
  // 영역 카드
  var stLbl={done:'완료',doing:'진행중',plan:'예정',talk:'협의중',review:'심사중'};
  var html='';
  AREAS.forEach(function(a){
    var cd=0,cg=0,cp=0,total=0;
    a.groups.forEach(function(g){ g.items.forEach(function(it){ total++;
      if(it.st==='done')cd++; else if(it.st==='doing')cg++; else cp++; }); });
    var pct= total? Math.round(cd/total*100):0;
    html+='<div class="area '+a.key+'">'
      +'<div class="area-hd"><div class="ic">'+a.ic+'</div>'
      +'<div><div class="nm">'+a.nm+'</div><div class="who">'+a.who+'</div></div>'
      +'<div class="cnt"><b class="cd">'+cd+'</b> 완료 · <b class="cg">'+cg+'</b> 진행'+(cp?' · <b>'+cp+'</b> 예정':'')+'</div></div>'
      +'<div class="pbar"><i style="width:'+pct+'%"></i></div>'
      +'<div class="items">';
    a.groups.forEach(function(g){
      html+='<div class="subhd">'+g.hd+'</div>';
      g.items.forEach(function(it){
        var dueBadge = it.due?'<span class="due">~'+it.due+'</span>':'';
        html+='<div class="item'+(it.st==='done'?' done':'')+'"><span class="st '+it.st+'">'+(stLbl[it.st]||it.st)+'</span>'
          +'<span class="tx"><b>'+it.t+'</b>'+dueBadge+(it.memo?'<span class="memo">'+it.memo+'</span>':'')+'</span></div>';
      });
    });
    html+='</div></div>';
  });
  document.getElementById('areas').innerHTML=html;
}
render();
</script>
</body></html>
